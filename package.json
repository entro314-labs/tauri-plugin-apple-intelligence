{
  "name": "@entro314labs/plugin-apple-intelligence",
  "version": "0.11.0",
  "description": "Apple Intelligence for Tauri: guest bindings for tauri-plugin-apple-intelligence plus a Vercel AI SDK provider with pluggable transports",
  "repository": {
    "type": "git",
    "url": "https://github.com/entro314-labs/tauri-plugin-apple-intelligence.git"
  },
  "homepage": "https://github.com/entro314-labs/tauri-plugin-apple-intelligence#readme",
  "bugs": {
    "url": "https://github.com/entro314-labs/tauri-plugin-apple-intelligence/issues"
  },
  "type": "module",
  "main": "dist-js/index.cjs",
  "module": "dist-js/index.mjs",
  "types": "dist-js/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist-js/index.d.mts",
        "default": "./dist-js/index.mjs"
      },
      "require": {
        "types": "./dist-js/index.d.cts",
        "default": "./dist-js/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist-js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "node tests/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist-js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.7",
    "@ai-sdk/provider-utils": "^5.0.27",
    "@tauri-apps/api": "^2.11.1",
    "@types/json-schema": "^7.0.15"
  },
  "peerDependencies": {
    "ai": "^7.0.14"
  },
  "devDependencies": {
    "ai": "^7.0.67",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.14",
    "typescript": "next"
  },
  "keywords": [
    "apple",
    "apple-intelligence",
    "tauri",
    "tauri-plugin",
    "vercel-ai-sdk",
    "on-device",
    "provider"
  ],
  "license": "MIT"
}
